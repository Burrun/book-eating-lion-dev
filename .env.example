# ==========================================
# 1. Application & Environment Settings
# ==========================================
SPRING_PROFILES_ACTIVE=local

# ==========================================
# 2. Database Settings (PostgreSQL / AWS Aurora)
# ==========================================
DB_HOST=localhost
DB_READER_HOST=localhost
DB_PORT=5432
DB_NAME=bookdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=rootpassword

# MSA Service DB User Credentials
CATALOG_DB_USERNAME=catalog_svc
CATALOG_DB_PASSWORD=catalog_pw
ORDER_DB_USERNAME=order_svc
ORDER_DB_PASSWORD=order_pw
MEMBER_DB_USERNAME=member_svc
MEMBER_DB_PASSWORD=member_pw
AI_DB_USERNAME=ai_svc
AI_DB_PASSWORD=ai_pw
AI_DB_NAME=bookdb
AI_DB_PORT=5432

# ==========================================
# 3. Redis Cache
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==========================================
# 4. AWS Credentials & Cognito
# ==========================================
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

AWS_COGNITO_REGION=ap-northeast-2
AWS_COGNITO_USER_POOL_ID=
AWS_COGNITO_CLIENT_ID=
AWS_COGNITO_CLIENT_SECRET=
KAKAOPAY_SECRET_KEY=

# ==========================================
# 5. AI (Bedrock & S3 Vectors)
# ==========================================
AI_CLIENTS=bedrock
AWS_BEDROCK_REGION=ap-northeast-2
AI_VECTOR_BUCKET=final-team3-wiki-vectors-prod
# EPUB 원본 버킷. 벡터 버킷과 다르다 — 원본은 관리자가 올린 파일, 벡터는 파생물이라
# 수명도 권한도 다르다. 키 규칙은 books/{bookId}/{파일명}.epub 이고,
# SQS 메시지의 epubS3Key 가 이 키를 그대로 담는다(버킷명은 메시지에 없다).
AI_EPUB_BUCKET=<epub-bucket>


# ==========================================
# 6. SQS (실제 큐. 로컬 대체 불가 — 공개 엔드포인트라 그대로 쓴다)
# ==========================================
# 🔴 로컬에서는 false 로 둘 것. SQS 는 메시지를 컨슈머 하나에게만 주므로, 켜면
#    배포된 컨슈머와 경쟁해 실제 이벤트를 가져가고 로컬은 처리에 실패한다(DLQ 행).
SQS_INGEST_ENABLED=false
SQS_INGEST_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/<account-id>/book-ingest-queue
SQS_PURCHASE_ENABLED=false
SQS_PURCHASE_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/<account-id>/book-purchase-queue

# DLQ 는 앱이 URL 로 참조하지 않는다 — 소스 큐의 RedrivePolicy 가 가리키므로 SDK 는
# 알 필요가 없다. 여기 적는 이유는 IaC 가 없어서 이 파일이 유일한 기록이기 때문이다.
# SqsWorker 의 실패 설계(정상 반환 = 삭제, 예외 = 재배달 → maxReceiveCount 초과 시 DLQ)가
# 이 정책에 의존한다. 정책이 없으면 처리 불가 메시지가 영원히 재배달된다.
#   book-ingest-queue   → book-ingest-dlq    maxReceiveCount=3   (재임베딩 비용 때문에 낮게)
#   book-purchase-queue → book-purchase-dlq  maxReceiveCount=5   (싸고 유실이 치명적이라 높게)
# DLQ 보관기간은 14일로 원본(4일)보다 길다 — 조사할 시간을 벌기 위해서다.
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ==========================================
# 7. SES Sandbox에서 검증한 발신 이메일 주소
# ==========================================
SES_FROM_ADDRESS=
FRONTEND_URL=http://localhost:3000
