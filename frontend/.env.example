VITE_USE_MOCK=true
VITE_API_BASE_URL=/api
KAKAOPAY_SECRET_KEY=

# 구독권 상품의 bookId. 비워두면 9001(db/postgres/90-demo-data.sql 이 넣는 값)로 떨어진다.
# order-api 의 SUBSCRIPTION_BOOK_ID 와 같은 값이어야 한다 — 어긋나면 결제는 되는데
# 구독이 안 생긴다(frontend/src/constants/subscription.ts 참고).
VITE_SUBSCRIPTION_BOOK_ID=9001

# 하이라이트 길이 상한은 여기 두지 않는다 — 팀 공용 값이라 .env.development /
# .env.production 에 커밋돼 있다(VITE_HIGHLIGHT_MAX_SELECTED_CHARS). 이 파일에서
# 덮어쓰면 로컬만 다른 상한으로 돌아가 배포 후 저장이 거절되는 차이가 생긴다.